CHATCLIPY_BASE_URL=https://app.chatclipy.com.br
CHATCLIPY_API_TOKEN=coloque_o_apiToken_da_empresa
CHATCLIPY_WHATSAPP_ID=123
# Valor inicial — pode ser trocado depois em /admin sem reiniciar o container
CHATCLIPY_TEMPLATE_NAME=nome_do_template_aprovado_na_meta
